# Database
DATABASE_URL="postgresql://user:password@localhost:5432/byteinbox-db?schema=public"

# JWT Secrets
AUTH_JWT_SECRET=your_jwt_secret_here_min_32_chars
AUTH_REFRESH_JWT_SECRET=your_refresh_jwt_secret_here_min_32_chars
TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe (Test Mode)
STRIPE_SECRET_KEY=You_stripe_your_secret
STRIPE_PUBLISHABLE_KEY=You_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=us-east-1
AWS_SES_CONFIGURATION_SET_NAME=byteinbox-tracking

# Frontend URL
FRONTEND_URL=http://localhost:3001

# OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# SMTP (for transactional emails like verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=ByteInbox

# Twilio (Optional - for MFA SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# App Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=DEBUG
